+  if (!render_target || rectangle.row_first || rectangle.rows != dump_rows) {
+    return nullptr;
+  }
+  const RenderTargetKey key = render_target->key();
+  if (key.is_depth || key.base_tiles != dump_base || key.msaa_samples != xenos::MsaaSamples::k1X ||
+      key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      key.pitch_tiles_at_32bpp != dump_pitch) {
+    return nullptr;
+  }
+  return render_target;
+}
+
+void VulkanRenderTargetCache::ForwardResolveFrom(VulkanRenderTarget* render_target,
+                                                 const draw_util::ResolveInfo& resolve_info,
+                                                 VulkanTextureCache& texture_cache,
+                                                 bool memory_skipped) {
+  const reg::RB_COPY_DEST_INFO dest = resolve_info.copy_dest_info;
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  // The render target as the blit's source.
+  constexpr VkPipelineStageFlags kStage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  constexpr VkAccessFlags kAccess = VK_ACCESS_TRANSFER_READ_BIT;
+  constexpr VkImageLayout kLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  command_processor_.PushImageMemoryBarrier(
+      render_target->image(), ui::vulkan::util::InitializeSubresourceRange(),
+      render_target->current_stage_mask(), kStage, render_target->current_access_mask(), kAccess,
+      render_target->current_layout(), kLayout);
+  render_target->SetUsage(kStage, kAccess, kLayout);
+  texture_cache.ForwardResolve(
+      render_target->image(), width * draw_resolution_scale_x(),
+      height * draw_resolution_scale_y(), resolve_info.copy_dest_base,
+      resolve_info.copy_dest_extent_start + resolve_info.copy_dest_extent_length -
+          resolve_info.copy_dest_base,
+      width, height, resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32,
+      uint32_t(dest.copy_dest_format), uint32_t(dest.copy_dest_endian), dest.copy_dest_swap != 0,
+      memory_skipped);
+}
