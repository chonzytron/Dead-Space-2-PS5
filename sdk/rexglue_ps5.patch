+// rip in its slot 20 and rsp in slot 23.
+inline uintptr_t ContextRip(void* uc) { return reinterpret_cast<uint64_t*>(static_cast<uint8_t*>(uc) + 64)[20]; }
+inline uintptr_t ContextRsp(void* uc) { return reinterpret_cast<uint64_t*>(static_cast<uint8_t*>(uc) + 64)[23]; }
+#else
+inline uintptr_t ContextRip(void* uc) { return uintptr_t(static_cast<ucontext_t*>(uc)->uc_mcontext.gregs[REG_RIP]); }
+inline uintptr_t ContextRsp(void* uc) { return uintptr_t(static_cast<ucontext_t*>(uc)->uc_mcontext.gregs[REG_RSP]); }
+#endif
+
+struct ThreadEntry {
+  std::atomic<bool> used{false};
+  pthread_t pthread{};
+  int tid = 0;
+  uintptr_t stack_top = 0;
+  char what[24] = {};
+  // filled by the signal handler
+  std::atomic<bool> want_stack{false};
+  std::atomic<int> done{0};
+  uintptr_t rip = 0, rsp = 0;
+  uintptr_t words[64] = {};
+  int nwords = 0;
+  // the profiler's (StartProfiler): where the thread was at the last sample
+  std::atomic<bool> want_prof{false};
+  std::atomic<uint32_t> prof_seq{0};
+  uintptr_t prof_rip = 0, prof_caller = 0;
+  uint64_t prof_cpu_ns = 0;
+};
+constexpr int kThreads = 192;
+ThreadEntry threads[kThreads];
+std::atomic<int> next_thread{0};
+thread_local ThreadEntry* my_entry = nullptr;
+
+// Words on a stack within this distance of the anchor are taken for return
+// addresses into the program (its text is under 256 MB).
+constexpr uintptr_t kNear = 256ull << 20;
+inline bool InProgram(uintptr_t v) {
+  const uintptr_t anchor = Anchor();
+  return v > (anchor > kNear ? anchor - kNear : 0x10000) && v < anchor + kNear;
+}
+
+void SampleHandler(int, siginfo_t*, void* uc) {
+  ThreadEntry* e = my_entry;
+  if (!e) return;
+  if (e->want_prof.exchange(false, std::memory_order_acq_rel)) {
+    // The profiler's sample: where the thread is and, when that is outside the
+    // program (the C library, the kernel's, the system's), the nearest return
+    // address into the program on its stack; and the processor time it has used.
+    const uintptr_t rip = ContextRip(uc), rsp = ContextRsp(uc);
+    uintptr_t caller = 0;
+    if (!InProgram(rip)) {
+      uintptr_t end = rsp + 4096;
+      if (e->stack_top && e->stack_top < end) end = e->stack_top;
+      for (uintptr_t p = rsp & ~uintptr_t(7); p + 8 <= end; p += 8) {
+        const uintptr_t v = *reinterpret_cast<uintptr_t*>(p);
+        if (InProgram(v)) {
+          caller = v;
+          break;
+        }
+      }
+    }
+    timespec used{};
+    e->prof_cpu_ns = clock_gettime(CLOCK_THREAD_CPUTIME_ID, &used) == 0
+                         ? uint64_t(used.tv_sec) * 1000000000ull + uint64_t(used.tv_nsec)
+                         : 0;
+    e->prof_rip = rip;
+    e->prof_caller = caller;
+    e->prof_seq.fetch_add(1, std::memory_order_release);
+  }
+  if (!e->want_stack.exchange(false, std::memory_order_acq_rel)) return;
+  e->rip = ContextRip(uc);
+  e->rsp = ContextRsp(uc);
+  uintptr_t end = e->rsp + 64 * 1024;
+  if (e->stack_top && e->stack_top < end) end = e->stack_top;
+  int n = 0;
+  for (uintptr_t p = e->rsp & ~uintptr_t(7); p + 8 <= end && n < 64; p += 8) {
+    const uintptr_t v = *reinterpret_cast<uintptr_t*>(p);
+    if (InProgram(v)) e->words[n++] = v;
+  }
+  e->nwords = n;
+  e->done.store(1, std::memory_order_release);
+}
+
+void InstallSampleHandler() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    struct sigaction sa = {};
+    sa.sa_sigaction = SampleHandler;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGPROF, &sa, nullptr);
+  });
+}
+
+char log_path[512];
+
+// Appends to a fixed buffer without the heap (the crash report runs in a
+// fault handler, possibly inside the allocator).
+struct RawLine {
+  char text[2048];
+  size_t size = 0;
+  void Add(const char* s) {
+    while (*s && size + 1 < sizeof(text)) text[size++] = *s++;
+  }
+  void Hex(uint64_t v) {
+    char digits[17];
+    int n = 0;
+    do {
+      digits[n++] = "0123456789ABCDEF"[v & 15];
+      v >>= 4;
+    } while (v);
+    while (n && size + 1 < sizeof(text)) text[size++] = digits[--n];
+  }
+  void Dec(uint64_t v) {
+    char digits[21];
+    int n = 0;
+    do {
+      digits[n++] = char('0' + v % 10);
+      v /= 10;
+    } while (v);
+    while (n && size + 1 < sizeof(text)) text[size++] = digits[--n];
+  }
+};
+
+}  // namespace
+
+void RegisterThread(const char* what) {
+  if (my_entry) return;
+  const int i = next_thread.fetch_add(1);
+  if (i >= kThreads) return;
+  ThreadEntry& e = threads[i];
+  e.pthread = pthread_self();
+  e.tid = ThreadId();
+  int marker = 0;
+  e.stack_top = reinterpret_cast<uintptr_t>(&marker) + 256;  // (a little above: the caller's frame)
+  std::strncpy(e.what, what ? what : "", sizeof(e.what) - 1);
+  my_entry = &e;
+  e.used.store(true, std::memory_order_release);
+}
+
+void UnregisterThread() {
+  ThreadEntry* e = my_entry;
+  if (!e) return;
+  // No more samples for it: its pthread_t can be another thread's soon, and a
+  // sample landing after its thread-specific data is gone would take a lookup
+  // that allocates in a signal handler.
+  sigset_t prof;
+  sigemptyset(&prof);
+  sigaddset(&prof, SIGPROF);
+  pthread_sigmask(SIG_BLOCK, &prof, nullptr);
+  e->used.store(false, std::memory_order_release);
+  my_entry = nullptr;
+}
+
+void SampleAllThreads() {
+  static std::mutex sampling;
+  std::lock_guard<std::mutex> one_at_a_time(sampling);
+  InstallSampleHandler();
+  REXLOG_INFO("ps5 stack: anchor {:X}", Anchor());
+  int count = next_thread.load();
+  if (count > kThreads) count = kThreads;
+  for (int i = 0; i < count; ++i) {
+    ThreadEntry& e = threads[i];
+    if (!e.used.load(std::memory_order_acquire)) continue;
+    e.done.store(0);
+    e.want_stack.store(true, std::memory_order_release);
+    if (pthread_kill(e.pthread, SIGPROF) != 0) continue;
+    for (int ms = 0; ms < 200 && !e.done.load(std::memory_order_acquire); ++ms) usleep(1000);
+    if (!e.done.load()) {
+      REXLOG_INFO("ps5 stack: tid {} {}: no answer", e.tid, e.what);
+      continue;
+    }
+    std::string line;
+    for (int k = 0; k < e.nwords; ++k) {
+      char buf[24];
+      std::snprintf(buf, sizeof(buf), " %lX", static_cast<unsigned long>(e.words[k] - Anchor() + 0x10000000));
+      line += buf;
+    }
+    REXLOG_INFO("ps5 stack: tid {} {}: rip {:X} |{}", e.tid, e.what, e.rip - Anchor() + 0x10000000, line);
+  }
+}
+
+namespace {
+
+// One thread's samples since the last report.
+struct ProfThread {
+  uint32_t seq = 0;
+  uint64_t samples = 0, outside = 0, cpu_ns_at_report = 0, cpu_ns = 0;
+  bool have_cpu = false;
+  // where (program-relative, as logged; for a place outside the program, the
+  // caller in the program with the top bit set) -> times found there
+  std::unordered_map<uint64_t, uint32_t> places;
+};
+
+void ProfilerThread(int report_seconds) {
+  constexpr uint64_t kOutside = 1ull << 63;
+  constexpr size_t kTop = 14, kTopBusy = 150;  // (more for a thread that used half a core)
+  // Places 16 bytes apart are one place: a hot loop is a few of these, not
+  // dozens of instructions each with its own count.
+  constexpr uint64_t kPlaceMask = ~uint64_t(15);
+  std::vector<ProfThread> prof(kThreads);
+  uint64_t report_at = NowMs() + uint64_t(report_seconds) * 1000, window_start = NowMs();
+  uint64_t swaps_at_report = Get(kSwaps), gpu_busy_at_report = Get(kGpuBusyUs);
+  REXLOG_INFO("ps5 prof: sampling every 10 ms, a report every {} s; anchor {:X}", report_seconds, Anchor());
+  for (;;) {
+    int count = next_thread.load();
+    if (count > kThreads) count = kThreads;
+    for (int i = 0; i < count; ++i) {
+      ThreadEntry& e = threads[i];
+      if (!e.used.load(std::memory_order_acquire)) continue;
+      e.want_prof.store(true, std::memory_order_release);
+      pthread_kill(e.pthread, SIGPROF);
+    }
+    usleep(10000);
+    for (int i = 0; i < count; ++i) {
+      ThreadEntry& e = threads[i];
+      ProfThread& t = prof[i];
+      const uint32_t seq = e.prof_seq.load(std::memory_order_acquire);
+      if (seq == t.seq) continue;  // (no answer this time: masked, or gone)
+      t.seq = seq;
+      const uintptr_t rip = e.prof_rip, caller = e.prof_caller;
+      t.cpu_ns = e.prof_cpu_ns;
+      if (!t.have_cpu) {
+        t.have_cpu = true;
+        t.cpu_ns_at_report = t.cpu_ns;
+      }
+      ++t.samples;
+      if (InProgram(rip)) {
+        ++t.places[uint64_t(rip - Anchor() + 0x10000000) & kPlaceMask];
+      } else {
+        ++t.outside;
+        ++t.places[kOutside | (caller ? uint64_t(caller - Anchor() + 0x10000000) : 0)];
+      }
+    }
+    const uint64_t now = NowMs();
+    if (now < report_at) continue;
+    const double seconds = double(now - window_start) / 1000.0;
+    const uint64_t swaps = Get(kSwaps);
+    const uint64_t gpu_busy = Get(kGpuBusyUs);
+    REXLOG_INFO("ps5 prof: {:.1f} s, {:.1f} frames/s, gpu busy {:.0f}%. Per thread: % of one core "
+                "used, samples, % of them outside the program, then place*count (~place: outside "
+                "the program, called from there)",
+                seconds, double(swaps - swaps_at_report) / seconds,
+                double(gpu_busy - gpu_busy_at_report) / (seconds * 1e4));
+    swaps_at_report = swaps;
+    gpu_busy_at_report = gpu_busy;
+    for (int i = 0; i < count; ++i) {
+      ProfThread& t = prof[i];
+      if (!t.samples) continue;
+      const double core = double(t.cpu_ns - t.cpu_ns_at_report) / (seconds * 1e9) * 100.0;
+      // (threads that did next to nothing are left out: the log stays readable)
+      if (core >= 2.0 || !t.cpu_ns) {
+        std::vector<std::pair<uint64_t, uint32_t>> top(t.places.begin(), t.places.end());
+        const size_t keep = std::min<size_t>(top.size(), core >= 50.0 ? kTopBusy : kTop);
+        std::partial_sort(top.begin(), top.begin() + std::ptrdiff_t(keep), top.end(),
+                          [](const auto& a, const auto& b) { return a.second > b.second; });
+        std::string line;
+        for (size_t k = 0; k < keep; ++k) {
+          char buf[40];
+          std::snprintf(buf, sizeof(buf), " %s%lX*%u", top[k].first & kOutside ? "~" : "",
+                        static_cast<unsigned long>(top[k].first & ~kOutside), top[k].second);
+          line += buf;
+        }
+        REXLOG_INFO("ps5 prof: tid {} {}: core {:.0f}% samples {} outside {:.0f}% |{}", threads[i].tid,
+                    threads[i].what, core, t.samples, 100.0 * double(t.outside) / double(t.samples), line);
+      }
+      t.samples = t.outside = 0;
+      t.cpu_ns_at_report = t.cpu_ns;
+      t.places.clear();
+    }
+    rex::FlushLogging();
+    window_start = NowMs();
+    report_at = window_start + uint64_t(report_seconds) * 1000;
+  }
+}
+
+}  // namespace
+
+namespace {
+std::atomic<bool> profiler_running{false};
+}  // namespace
+
+bool ProfilerRunning() { return profiler_running.load(std::memory_order_relaxed); }
+
+void StartProfiler(int report_seconds) {
+  static std::once_flag once;
+  std::call_once(once, [report_seconds] {
+    profiler_running.store(true, std::memory_order_relaxed);
+    InstallSampleHandler();
+    std::thread(ProfilerThread, report_seconds < 5 ? 5 : report_seconds).detach();
+  });
+}
+
+void SetLogPath(const char* path) {
+  if (!path) return;
+  std::strncpy(log_path, path, sizeof(log_path) - 1);
+}
+
+void UnhandledHostFault(uintptr_t rip, uintptr_t address, uintptr_t rsp) {
+  static std::atomic<uint64_t> count{0};
+  const uint64_t n = ++count;
+  Add(kUnhandledFaults);
+  if (n > 1) {
+    // Again (it retries the instruction) or another thread: the first report
+    // ends the game.
+    if (n == 2 && crash_hook) crash_hook("a thread crashed");  // (doesn't return)
+    return;
+  }
+  uint64_t expected = 0;
+  crashed_at_ms.compare_exchange_strong(expected, NowMs() | 1);
+  const uintptr_t anchor = Anchor();
+  static RawLine line;
+  line.Add("\n[ps5 crash] thread ");
+  line.Dec(uint64_t(my_entry ? my_entry->tid : ThreadId()));
+  line.Add(" (");
+  line.Add(my_entry ? my_entry->what : "unregistered");
+  line.Add(") faulted at ");
+  line.Hex(address);
+  if (address >= guest_arena_lo && address < guest_arena_hi) {
+    line.Add(" (guest offset ");
+    line.Hex(address - guest_arena_lo);
+    line.Add(")");
+  }
+  line.Add(" (rip ");
+  line.Hex(rip);
+  line.Add(", anchor-relative ");
+  line.Hex(rip - anchor + 0x10000000);
+  line.Add(") | stack:");
+  if (ThreadEntry* e = my_entry) {
+    uintptr_t end = rsp + 64 * 1024;
+    if (e->stack_top && e->stack_top < end) end = e->stack_top;
+    int k = 0;
+    for (uintptr_t p = rsp & ~uintptr_t(7); p + 8 <= end && k < 48; p += 8) {
+      const uintptr_t v = *reinterpret_cast<uintptr_t*>(p);
+      if (InProgram(v)) {
+        line.Add(" ");
+        line.Hex(v - anchor + 0x10000000);
+        ++k;
+      }
+    }
+  }
+  line.Add("\n");
+  const char* path = log_path[0] ? log_path : "/data/homebrew/ds2_crash.log";
+  const int fd = open(path, O_WRONLY | O_APPEND | O_CREAT, 0666);
+  if (fd >= 0) {
+    (void)write(fd, line.text, line.size);
+    close(fd);
+  }
+}
+
+}  // namespace rex::ps5diag
+
+#endif  // REX_PS5_PROGRAM
diff --git a/src/core/ps5_libc_extras.c b/src/core/ps5_libc_extras.c
new file mode 100644
index 00000000..87f97fed
--- /dev/null
+++ b/src/core/ps5_libc_extras.c
@@ -0,0 +1,128 @@
+/**
+ * [ps5 port] Standard functions the PS5's libc doesn't export, used by the
+ * runtime (ffs: math_gcc.cpp; timegm: STFS timestamps) and SDL3 (getresuid /
+ * getresgid: its GTK loader, never used on the PS5). isatty / mkstemp: the
+ * PS5 only exports them from libScePosixForWebKit, which a game can't use
+ * (spdlog's isatty call jumped to address 0).
+ *
+ * From the GTA IV PS5 port (elripalda), where each was found on a console.
+ */
+#if defined(__PROSPERO__)
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+// Imports only the system's libkernel_sys exports, which a game can't load:
+// each one was a jump to address 0 (libc++'s create_hard_link called link()).
+// They fail cleanly instead, and every caller has a fallback.
+int link(const char* from, const char* to) {
+  (void)from, (void)to;
+  errno = ENOTSUP;
+  return -1;
+}
+int symlink(const char* target, const char* path) {
+  (void)target, (void)path;
+  errno = ENOTSUP;
+  return -1;
+}
+ssize_t readlink(const char* path, char* buf, size_t size) {
+  (void)path, (void)buf, (void)size;
+  errno = EINVAL;  // (not a symbolic link: there are none)
+  return -1;
+}
+long pathconf(const char* path, int name) {
+  (void)path;
+  switch (name) {
+    case _PC_NAME_MAX: return 255;
+    case _PC_PATH_MAX: return 1024;
+    case _PC_LINK_MAX: return 1;
+    default: errno = EINVAL; return -1;
+  }
+}
+pid_t fork(void) {
+  errno = ENOSYS;
+  return -1;
+}
+pid_t vfork(void) {
+  errno = ENOSYS;
+  return -1;
+}
+pid_t setsid(void) {
+  errno = EPERM;
+  return -1;
+}
+
+// No terminals on a PS5.
+int isatty(int fd) {
+  (void)fd;
+  errno = ENOTTY;
+  return 0;
+}
+
+// mkstemp: replace the trailing XXXXXX until a new file can be created.
+int mkstemp(char* path) {
+  static const char kChars[] = "abcdefghijklmnopqrstuvwxyz0123456789";
+  size_t length = path ? strlen(path) : 0;
+  if (length < 6 || strcmp(path + length - 6, "XXXXXX") != 0) {
+    errno = EINVAL;
+    return -1;
+  }
+  static uint64_t counter = 0;
+  for (int attempt = 0; attempt < 1000; ++attempt) {
+    uint64_t v = (uint64_t)time(NULL) * 2654435761u + (++counter) * 0x9E3779B97F4A7C15ull;
+    for (int i = 0; i < 6; ++i) {
+      path[length - 6 + i] = kChars[v % 36];
+      v /= 36;
+    }
+    int fd = open(path, O_RDWR | O_CREAT | O_EXCL, 0600);
+    if (fd >= 0 || errno != EEXIST) return fd;
+  }
+  errno = EEXIST;
+  return -1;
+}
+
+int ffs(int value) { return __builtin_ffs(value); }
+
+// UTC broken-down time to seconds since the epoch (days_from_civil, Howard
+// Hinnant's public-domain algorithm); normalizes like mktime does.
+time_t timegm(struct tm* tm) {
+  int64_t year = (int64_t)tm->tm_year + 1900;
+  int64_t month = tm->tm_mon;  // 0..11, may be out of range
+  year += month / 12;
+  month %= 12;
+  if (month < 0) {
+    month += 12;
+    --year;
+  }
+  int64_t m = month + 1;  // 1..12
+  int64_t y = year - (m <= 2);
+  int64_t era = (y >= 0 ? y : y - 399) / 400;
+  int64_t yoe = y - era * 400;
+  int64_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + tm->tm_mday - 1;
+  int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  int64_t days = era * 146097 + doe - 719468;
+  return (time_t)(days * 86400 + (int64_t)tm->tm_hour * 3600 + (int64_t)tm->tm_min * 60 +
+                  tm->tm_sec);
+}
+
+int getresuid(uid_t* ruid, uid_t* euid, uid_t* suid) {
+  uid_t u = getuid(), e = geteuid();
+  if (ruid) *ruid = u;
+  if (euid) *euid = e;
+  if (suid) *suid = e;
+  return 0;
+}
+
+int getresgid(gid_t* rgid, gid_t* egid, gid_t* sgid) {
+  gid_t g = getgid(), e = getegid();
+  if (rgid) *rgid = g;
+  if (egid) *egid = e;
+  if (sgid) *sgid = e;
+  return 0;
+}
+#endif
