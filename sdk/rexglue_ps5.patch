+// [ps5 port] Resolve forwarding. On the Xbox 360 a resolve copies a render
+// target out of EDRAM into memory, where a texture reads it. Emulated, that is
+// three full-picture passes at the scaled resolution: the render target dumped
+// to the EDRAM buffer, the resolve into the scaled resolve buffer in the
+// guest's tiled layout, and, when a texture reads it, that untiled back into a
+// texture (LoadTextureDataFromResidentMemoryImpl). Here the render target is
+// also blitted into an image of its own at the resolve, and a texture that is
+// exactly that picture (address, size, pitch, format, endianness, one mip) is
+// filled from it with an image copy instead of the untiling. The memory is
+// still written, so whatever else reads it sees what it always did; a write
+// to the range afterwards (another resolve, the processor) drops the image.
+
+bool VulkanTextureCache::IsResolveForwardingEnabled() const {
+  static const bool enabled = REXCVAR_GET(ps5_resolve_forward) > 0;
+  return enabled && IsDrawResolutionScaled();
+}
+
+void VulkanTextureCache::ForwardedRangeWritten(uint32_t first, uint32_t last) {
+  for (ForwardedResolve& forwarded : forwarded_resolves_) {
+    if (forwarded.current.load(std::memory_order_relaxed) && first <= forwarded.dest_last &&
+        last >= forwarded.dest_base) {
+      forwarded.current.store(false, std::memory_order_release);
+    }
+  }
+}
+
+void VulkanTextureCache::ForwardResolve(VkImage src_image, uint32_t width_scaled,
+                                        uint32_t height_scaled, uint32_t dest_base,
+                                        uint32_t dest_length, uint32_t width, uint32_t height,
+                                        uint32_t pitch, uint32_t format, uint32_t endian,
+                                        bool swap, bool memory_skipped) {
+  if (!dest_length) {
+    return;
+  }
+  const VkFormat image_format = swap ? VK_FORMAT_B8G8R8A8_UNORM : VK_FORMAT_R8G8B8A8_UNORM;
+  // The same picture as before, or the least recently used slot.
+  ForwardedResolve* slot = nullptr;
+  ForwardedResolve* oldest = nullptr;
+  for (ForwardedResolve& forwarded : forwarded_resolves_) {
+    if (forwarded.image != VK_NULL_HANDLE && forwarded.dest_base == dest_base &&
+        forwarded.width_scaled == width_scaled && forwarded.height_scaled == height_scaled &&
+        forwarded.format == image_format) {
+      slot = &forwarded;
+      break;
+    }
+    if (!oldest || forwarded.last_used < oldest->last_used) {
+      oldest = &forwarded;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  if (!slot) {
+    slot = oldest;
+    if (slot->image != VK_NULL_HANDLE) {
+      // All taken: the GPU may still be using them, so none is replaced; this
+      // picture just isn't forwarded.
+      return;
+    }
+    VkImageCreateInfo image_create_info = {};
+    image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_create_info.imageType = VK_IMAGE_TYPE_2D;
+    image_create_info.format = image_format;
+    image_create_info.extent = {width_scaled, height_scaled, 1};
+    image_create_info.mipLevels = 1;
+    image_create_info.arrayLayers = 1;
+    image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_create_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!ui::vulkan::util::CreateDedicatedAllocationImage(
+            vulkan_device, image_create_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+            slot->image, slot->memory)) {
+      slot->image = VK_NULL_HANDLE;
+      REXGPU_WARN("ps5 resolve forwarding: no {}x{} image", width_scaled, height_scaled);
+      return;
+    }
+    slot->format = image_format;
+    slot->width_scaled = width_scaled;
+    slot->height_scaled = height_scaled;
+    REXGPU_INFO("ps5 resolve forwarding: an image for {:08X} ({}x{}, {}x{} scaled, format {}{})",
+                dest_base, width, height, width_scaled, height_scaled, format,
+                swap ? ", red and blue swapped" : "");
+  }
+  slot->dest_base = dest_base;
+  slot->dest_last = dest_base + dest_length - 1;
+  slot->width = width;
+  slot->height = height;
+  slot->pitch = pitch;
+  slot->guest_format = format;
+  slot->endian = endian;
+  slot->swap = swap;
+  slot->last_used = ++forwarded_resolve_clock_;
+  if (memory_skipped && !slot->memory_stale) {
+    REXGPU_INFO("ps5 resolve forwarding: {:08X} ({}x{}) no longer written to memory: only "
+                "forwarding has read it",
+                dest_base, width, height);
+  }
+  slot->memory_stale = memory_skipped;
+
+  // (the image was last read by a copy, or never used: its contents don't matter)
+  command_processor_.PushImageMemoryBarrier(
+      slot->image, ui::vulkan::util::InitializeSubresourceRange(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkImageBlit blit = {};
+  blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  blit.srcOffsets[1] = {int32_t(width_scaled), int32_t(height_scaled), 1};
+  blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  blit.dstOffsets[1] = {int32_t(width_scaled), int32_t(height_scaled), 1};
+  command_processor_.deferred_command_buffer().CmdVkBlitImage(
+      src_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot->image,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, blit, VK_FILTER_NEAREST);
+  command_processor_.PushImageMemoryBarrier(
+      slot->image, ui::vulkan::util::InitializeSubresourceRange(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  slot->current.store(true, std::memory_order_release);
+}
+
+bool VulkanTextureCache::LoadForwardedResolve(VulkanTexture& texture) {
+  const TextureKey key = texture.key();
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      key.mip_max_level || key.packed_mips || !key.tiled || key.signed_separate) {
+    return false;
+  }
+  const uint32_t base = key.base_page << 12;
+  for (ForwardedResolve& forwarded : forwarded_resolves_) {
+    if (forwarded.image == VK_NULL_HANDLE ||
+        !forwarded.current.load(std::memory_order_acquire) || forwarded.dest_base != base ||
+        forwarded.width != key.GetWidth() || forwarded.height != key.GetHeight() ||
+        forwarded.pitch != key.pitch * 32 || forwarded.guest_format != uint32_t(key.format) ||
+        forwarded.endian != uint32_t(key.endianness)) {
+      continue;
+    }
+    const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+    if (host_format_pair.format_unsigned.format != VK_FORMAT_R8G8B8A8_UNORM ||
+        forwarded.width_scaled != key.GetWidth() * draw_resolution_scale_x() ||
+        forwarded.height_scaled != key.GetHeight() * draw_resolution_scale_y()) {
+      return false;
+    }
+    static const bool check = REXCVAR_GET(ps5_resolve_forward_check);
+    if (check && !forward_check_.pending && rex::ps5diag::NowMs() >= forward_check_.next_ms) {
+      // Loaded as before this time, and compared (RecordForwardCheck).
+      forward_check_slot_ = &forwarded;
+      return false;
+    }
+    texture.MarkAsUsed();
+    VulkanTexture::Usage texture_old_usage =
+        texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+    if (texture_old_usage != VulkanTexture::Usage::kTransferDestination) {
+      VkPipelineStageFlags texture_src_stage_mask, texture_dst_stage_mask;
+      VkAccessFlags texture_src_access_mask, texture_dst_access_mask;
+      VkImageLayout texture_old_layout, texture_new_layout;
+      GetTextureUsageMasks(texture_old_usage, texture_src_stage_mask, texture_src_access_mask,
+                           texture_old_layout);
+      GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, texture_dst_stage_mask,
+                           texture_dst_access_mask, texture_new_layout);
+      command_processor_.PushImageMemoryBarrier(
+          texture.image(), ui::vulkan::util::InitializeSubresourceRange(), texture_src_stage_mask,
+          texture_dst_stage_mask, texture_src_access_mask, texture_dst_access_mask,
+          texture_old_layout, texture_new_layout);
+    }
+    command_processor_.SubmitBarriers(true);
+    VkImageCopy copy = {};
+    copy.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    copy.extent = {forwarded.width_scaled, forwarded.height_scaled, 1};
+    command_processor_.deferred_command_buffer().CmdVkCopyImage(
+        forwarded.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, copy);
+    forwarded.last_used = ++forwarded_resolve_clock_;
+    if (forwarded.proof_loads < kForwardProofLoads) ++forwarded.proof_loads;
+#if REX_PS5_PROGRAM
+    if (rex::ps5diag::ProfilerRunning()) {
+      command_processor_.NoteGpuResolvedLoad(
+          fmt::format("forwarded: texture format {} at {:08X}, {}x{}", uint32_t(key.format), base,
+                      key.GetWidth(), key.GetHeight()));
+    }
+#endif
+    return true;
+  }
+  return false;
+}
+
+void VulkanTextureCache::RecordForwardCheck(VulkanTexture& texture, ForwardedResolve& forwarded) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  ForwardCheck& check = forward_check_;
+  const VkDeviceSize size = VkDeviceSize(forwarded.width_scaled) * forwarded.height_scaled * 4;
+  if (check.size != size) {
+    for (uint32_t i = 0; i < 2; ++i) {
+      if (check.buffers[i] != VK_NULL_HANDLE) {
+        dfn.vkDestroyBuffer(device, check.buffers[i], nullptr);
+        dfn.vkFreeMemory(device, check.memories[i], nullptr);
+        check.buffers[i] = VK_NULL_HANDLE;
+      }
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, check.buffers[i], check.memories[i])) {
+        check.buffers[i] = VK_NULL_HANDLE;
+        check.size = 0;
+        return;
+      }
+    }
+    check.size = size;
+  }
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  // The texture, just loaded the usual way (in TRANSFER_DST_OPTIMAL), and the
+  // forwarded picture (TRANSFER_SRC_OPTIMAL), each into a buffer.
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_TRANSFER_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {forwarded.width_scaled, forwarded.height_scaled, 1};
+  command_buffer.CmdVkCopyImageToBuffer(texture.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        check.buffers[0], region);
+  command_buffer.CmdVkCopyImageToBuffer(forwarded.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        check.buffers[1], region);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.PushBufferMemoryBarrier(check.buffers[0], 0, VK_WHOLE_SIZE,
+                                             VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                             VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                                             VK_ACCESS_HOST_READ_BIT);
+  command_processor_.PushBufferMemoryBarrier(check.buffers[1], 0, VK_WHOLE_SIZE,
+                                             VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                             VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                                             VK_ACCESS_HOST_READ_BIT);
+  check.submission = command_processor_.GetCurrentSubmission();
+  check.base = forwarded.dest_base;
+  check.width = forwarded.width_scaled;
+  check.height = forwarded.height_scaled;
+  check.pending = true;
+}
+
+void VulkanTextureCache::FinishForwardCheck() {
+  ForwardCheck& check = forward_check_;
+  if (!check.pending || command_processor_.GetCompletedSubmission() < check.submission) {
+    return;
+  }
+  check.pending = false;
+  check.next_ms = rex::ps5diag::NowMs() + 5000;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  void* mapped[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (dfn.vkMapMemory(device, check.memories[i], 0, VK_WHOLE_SIZE, 0, &mapped[i]) !=
+        VK_SUCCESS) {
+      mapped[i] = nullptr;
+    }
+  }
+  if (mapped[0] && mapped[1]) {
+    // (both from non-coherent memory perhaps: invalidated first)
+    VkMappedMemoryRange ranges[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      ranges[i].sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      ranges[i].memory = check.memories[i];
+      ranges[i].size = VK_WHOLE_SIZE;
+    }
+    dfn.vkInvalidateMappedMemoryRanges(device, 2, ranges);
+    const uint8_t* a = static_cast<const uint8_t*>(mapped[0]);
+    const uint8_t* b = static_cast<const uint8_t*>(mapped[1]);
+    uint64_t differing = 0, max_diff = 0;
+    uint32_t first_x = 0, first_y = 0, first_a = 0, first_b = 0;
+    uint64_t differing_rows[4] = {};  // (first row, first column, last row, elsewhere)
+    for (uint32_t y = 0; y < check.height; ++y) {
+      for (uint32_t x = 0; x < check.width; ++x) {
+        const size_t o = (size_t(y) * check.width + x) * 4;
+        uint32_t pa, pb;
+        std::memcpy(&pa, a + o, 4);
+        std::memcpy(&pb, b + o, 4);
+        if (pa == pb) continue;
+        if (!differing) {
+          first_x = x;
+          first_y = y;
+          first_a = pa;
+          first_b = pb;
+        }
+        ++differing;
+        for (uint32_t c = 0; c < 4; ++c) {
+          const int d = int(a[o + c]) - int(b[o + c]);
+          max_diff = std::max<uint64_t>(max_diff, uint64_t(d < 0 ? -d : d));
+        }
+        ++differing_rows[y == 0 ? 0 : x == 0 ? 1 : y == check.height - 1 ? 2 : 3];
+      }
+    }
+    REXGPU_INFO(
+        "ps5 resolve forwarding check {:08X} ({}x{}): {} of {} pixels differ (largest channel "
+        "difference {}; in the first row {}, first column {}, last row {}, elsewhere {}){}",
+        check.base, check.width, check.height, differing, uint64_t(check.width) * check.height,
+        max_diff, differing_rows[0], differing_rows[1], differing_rows[2], differing_rows[3],
+        differing ? fmt::format("; first at {},{}: loaded {:08X}, forwarded {:08X}", first_x,
+                                first_y, first_a, first_b)
+                  : std::string());
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (mapped[i]) dfn.vkUnmapMemory(device, check.memories[i]);
+  }
+}
+
+bool VulkanTextureCache::CanResolveSkipMemory(const draw_util::ResolveInfo& resolve_info) const {
+  static const bool skip = REXCVAR_GET(ps5_resolve_forward) >= 2 &&
+                           !REXCVAR_GET(ps5_resolve_forward_check);
+  if (!skip) {
+    return false;
+  }
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  for (const ForwardedResolve& forwarded : forwarded_resolves_) {
+    if (forwarded.image != VK_NULL_HANDLE && forwarded.dest_base == resolve_info.copy_dest_base &&
+        forwarded.width == width && forwarded.height == height &&
+        forwarded.swap == (resolve_info.copy_dest_info.copy_dest_swap != 0) &&
+        forwarded.endian == uint32_t(resolve_info.copy_dest_info.copy_dest_endian)) {
+      return !forwarded.needs_memory && forwarded.proof_loads >= kForwardProofLoads;
+    }
+  }
+  return false;
+}
+
+void VulkanTextureCache::NoteUnforwardedResolvedLoad(const TextureKey& key, uint32_t size) {
+  const uint32_t first = key.base_page << 12, last = first + std::max(size, UINT32_C(1)) - 1;
+  for (ForwardedResolve& forwarded : forwarded_resolves_) {
+    if (forwarded.image == VK_NULL_HANDLE || first > forwarded.dest_last ||
+        last < forwarded.dest_base || forwarded.needs_memory) {
+      continue;
+    }
+    forwarded.needs_memory = true;
+    forwarded.proof_loads = 0;
+    REXGPU_INFO("ps5 resolve forwarding: {:08X} ({}x{}) is read as a texture it doesn't match "
+                "(format {} at {:08X}, {}x{}){}: always written to memory from now on",
+                forwarded.dest_base, forwarded.width, forwarded.height, uint32_t(key.format), first,
+                key.GetWidth(), key.GetHeight(),
+                forwarded.memory_stale ? ", and this once read what was there before" : "");
+  }
+}
+
 }  // namespace rex::graphics::vulkan
