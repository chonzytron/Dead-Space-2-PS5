+bool SharedMemory::MakePageVolatile(uint32_t page) {
+  const uint64_t bit = uint64_t(1) << (page & 63);
+  std::atomic<uint64_t>& block = system_page_flags_volatile_[page >> 6];
+  if ((block.load(std::memory_order_relaxed) & bit) ||
+      (system_page_flags_valid_and_gpu_written_[page >> 6] & bit) ||
+      volatile_page_count_.load(std::memory_order_relaxed) >= kVolatileMaxPages) {
+    return false;
+  }
+  VolatilePage& info = volatile_pages_[page];
+  info.sticky = true;
+  info.epoch.fetch_add(1, std::memory_order_relaxed);
+  block.fetch_or(bit, std::memory_order_relaxed);
+  volatile_page_count_.fetch_add(1, std::memory_order_relaxed);
+  volatile_made_.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+bool SharedMemory::ClearPageVolatile(uint32_t page) {
+  const uint64_t bit = uint64_t(1) << (page & 63);
+  std::atomic<uint64_t>& block = system_page_flags_volatile_[page >> 6];
+  if (!(block.load(std::memory_order_relaxed) & bit)) {
+    return false;
+  }
+  block.fetch_and(~bit, std::memory_order_relaxed);
+  VolatilePage& info = volatile_pages_[page];
+  info.faults = 0;
+  info.epoch.fetch_add(1, std::memory_order_relaxed);
+  volatile_page_count_.fetch_sub(1, std::memory_order_relaxed);
+  return true;
+}
