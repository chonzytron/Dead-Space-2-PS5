+void VulkanCommandProcessor::InitializeGpuTimestamps() {
+  gpu_timestamp_pool_ = VK_NULL_HANDLE;
+  gpu_timestamp_slot_submission_.fill(0);
+  gpu_timestamp_last_end_ = 0;
+  gpu_busy_ns_unreported_ = 0.0;
+#if REX_PS5_PROGRAM
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const auto& ifn = vulkan_device->vulkan_instance()->functions();
+  VkDevice device = vulkan_device->device();
+
+  VkPhysicalDeviceProperties properties;
+  ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+  uint32_t family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count,
+                                               nullptr);
+  std::vector<VkQueueFamilyProperties> families(family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count,
+                                               families.data());
+  const uint32_t family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t valid_bits = family < family_count ? families[family].timestampValidBits : 0;
+  if (!valid_bits || !(properties.limits.timestampPeriod > 0.0f)) {
+    REXGPU_INFO("GPU time isn't measured: no timestamps on the graphics queue");
+    return;
+  }
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kGpuTimestampSlots * 2;
+  if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &gpu_timestamp_pool_) != VK_SUCCESS) {
+    gpu_timestamp_pool_ = VK_NULL_HANDLE;
+    REXGPU_WARN("GPU time isn't measured: no timestamp query pool");
+    return;
+  }
+  gpu_timestamp_ns_per_tick_ = double(properties.limits.timestampPeriod);
+  gpu_timestamp_mask_ = valid_bits >= 64 ? UINT64_MAX : (uint64_t(1) << valid_bits) - 1;
+  gpu_timestamp_one_second_ = uint64_t(1e9 / gpu_timestamp_ns_per_tick_);
+  REXGPU_INFO("GPU time is measured ({} ns a tick, {} bits)", gpu_timestamp_ns_per_tick_,
+              valid_bits);
+  // (what the time goes to, while the profiler runs)
+  pool_info.queryCount = kGpuPhaseSlots * kGpuPhaseQueriesPerSlot;
+  if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &gpu_phase_pool_) != VK_SUCCESS) {
+    gpu_phase_pool_ = VK_NULL_HANDLE;
+  }
+  gpu_phase_slot_submission_.fill(0);
+#endif
+}
+
+void VulkanCommandProcessor::ShutdownGpuTimestamps() {
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  if (gpu_timestamp_pool_ != VK_NULL_HANDLE) {
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_timestamp_pool_,
+                                                  nullptr);
+  }
+  if (gpu_phase_pool_ != VK_NULL_HANDLE) {
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_phase_pool_,
+                                                  nullptr);
+  }
+  gpu_timestamp_pool_ = VK_NULL_HANDLE;
+  gpu_phase_pool_ = VK_NULL_HANDLE;
+  gpu_timestamp_slot_submission_.fill(0);
+  gpu_phase_slot_submission_.fill(0);
+  gpu_phase_timing_ = false;
+}
+
+void VulkanCommandProcessor::BeginGpuPhaseTiming() {
+  gpu_phase_timing_ = false;
+  if (gpu_phase_pool_ == VK_NULL_HANDLE || !rex::ps5diag::ProfilerRunning()) {
+    return;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  const uint32_t slot = uint32_t(submission % kGpuPhaseSlots);
+  if (gpu_phase_slot_submission_[slot]) {
+    return;  // (an earlier submission's, not read yet)
+  }
+  gpu_phase_timing_ = true;
+  gpu_phase_slot_ = slot;
+  gpu_phase_query_count_ = 1;  // (query 0: written when the submission starts)
+  std::vector<GpuInterval>& intervals = gpu_phase_slot_intervals_[slot];
+  intervals.clear();
+  intervals.push_back({gpu_phase_, kNoDrawKind});
+}
+
+void VulkanCommandProcessor::MarkGpuDraw(const GpuDrawKind& kind) {
+  if (!gpu_phase_timing_ || !submission_open_ ||
+      gpu_phase_query_count_ + 1 >= kGpuPhaseQueriesPerSlot) {
+    return;
+  }
+  auto id_it = gpu_draw_kind_ids_.find(kind);
+  uint32_t id;
+  if (id_it != gpu_draw_kind_ids_.end()) {
+    id = id_it->second;
+  } else {
+    id = uint32_t(gpu_draw_kinds_.size());
+    gpu_draw_kind_ids_.emplace(kind, id);
+    gpu_draw_kinds_.push_back(kind);
+    gpu_draw_kind_ns_.push_back(0.0);
+    gpu_draw_kind_count_.push_back(0);
+  }
+  std::vector<GpuInterval>& intervals = gpu_phase_slot_intervals_[gpu_phase_slot_];
+  intervals.back().draw_kind = id;
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_phase_pool_,
+      gpu_phase_slot_ * kGpuPhaseQueriesPerSlot + gpu_phase_query_count_);
+  ++gpu_phase_query_count_;
+  intervals.push_back({gpu_phase_, kNoDrawKind});
+}
+
+void VulkanCommandProcessor::NoteGpuTransfer(uint32_t source_key, uint32_t dest_key,
+                                             uint32_t tiles, bool skipped) {
+  GpuTransferStats& stats = gpu_transfer_stats_[(uint64_t(source_key) << 32) | dest_key];
+  ++stats.count;
+  stats.tiles += tiles;
+  stats.skipped += skipped ? 1 : 0;
+}
+
+void VulkanCommandProcessor::NoteGpuResolve(std::string description) {
+  ++gpu_resolve_stats_[std::move(description)];
+}
+
+void VulkanCommandProcessor::NoteGpuResolvedLoad(std::string description) {
+  ++gpu_resolved_load_stats_[std::move(description)];
+}
+
+void VulkanCommandProcessor::SetGpuPhase(GpuPhase phase) {
+  if (phase == gpu_phase_) {
+    return;
+  }
+  gpu_phase_ = phase;
+  // (one query is kept for the end of the submission)
+  if (!gpu_phase_timing_ || !submission_open_ ||
+      gpu_phase_query_count_ + 1 >= kGpuPhaseQueriesPerSlot) {
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_phase_pool_,
+      gpu_phase_slot_ * kGpuPhaseQueriesPerSlot + gpu_phase_query_count_);
+  ++gpu_phase_query_count_;
+  gpu_phase_slot_intervals_[gpu_phase_slot_].push_back({phase, kNoDrawKind});
+  ++gpu_phase_entries_[size_t(phase)];
+}
+
+void VulkanCommandProcessor::ReadGpuPhases(uint64_t first_submission, uint64_t last_submission) {
+  if (gpu_phase_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  bool any = false;
+  std::vector<uint64_t> ticks;
+  for (uint64_t submission = first_submission; submission <= last_submission; ++submission) {
+    const uint32_t slot = uint32_t(submission % kGpuPhaseSlots);
+    if (gpu_phase_slot_submission_[slot] != submission) {
+      continue;
+    }
+    gpu_phase_slot_submission_[slot] = 0;
+    const std::vector<GpuInterval>& intervals = gpu_phase_slot_intervals_[slot];
+    const uint32_t query_count = uint32_t(intervals.size()) + 1;
+    ticks.resize(query_count);
+    if (vulkan_device->functions().vkGetQueryPoolResults(
+            vulkan_device->device(), gpu_phase_pool_, slot * kGpuPhaseQueriesPerSlot,
+            query_count, sizeof(uint64_t) * query_count, ticks.data(), sizeof(uint64_t),
+            VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    for (size_t i = 0; i < intervals.size(); ++i) {
+      const uint64_t from = ticks[i] & gpu_timestamp_mask_;
+      const uint64_t to = ticks[i + 1] & gpu_timestamp_mask_;
+      if (to < from || to - from > gpu_timestamp_one_second_) {
+        continue;
+      }
+      const double ns = double(to - from) * gpu_timestamp_ns_per_tick_;
+      const GpuInterval& interval = intervals[i];
+      if (interval.draw_kind == kNoDrawKind) {
+        gpu_phase_ns_[size_t(interval.phase)] += ns;
+        continue;
+      }
+      gpu_draw_kind_ns_[interval.draw_kind] += ns;
+      ++gpu_draw_kind_count_[interval.draw_kind];
+      gpu_draw_ns_ += ns;
+      ++gpu_draw_count_;
+      const size_t bucket = ns < 10e3 ? 0 : ns < 50e3 ? 1 : ns < 200e3 ? 2 : ns < 1000e3 ? 3 : 4;
+      gpu_draw_bucket_ns_[bucket] += ns;
+      ++gpu_draw_bucket_count_[bucket];
+    }
+    any = true;
+  }
+  if (any) {
+    ReportGpuPhases();
+  }
+}
+
+void VulkanCommandProcessor::ReportGpuPhases() {
+#if REX_PS5_PROGRAM
+  const uint64_t now_ms = rex::ps5diag::NowMs();
+  if (!gpu_phase_report_ms_) {
+    gpu_phase_report_ms_ = now_ms;
+    gpu_phase_report_swaps_ = rex::ps5diag::Get(rex::ps5diag::kSwaps);
+    return;
+  }
+  if (now_ms - gpu_phase_report_ms_ < 30000) {
+    return;
+  }
+  const uint64_t swaps = rex::ps5diag::Get(rex::ps5diag::kSwaps);
+  const double frames = double(std::max<uint64_t>(swaps - gpu_phase_report_swaps_, 1));
+  const double seconds = double(now_ms - gpu_phase_report_ms_) / 1000.0;
+  auto ms = [&](GpuPhase phase) { return gpu_phase_ns_[size_t(phase)] / 1e6 / frames; };
+  auto per_frame = [&](GpuPhase phase) { return double(gpu_phase_entries_[size_t(phase)]) / frames; };
+  const double msaa_draws = double(std::max<uint64_t>(
+      gpu_phase_draws_by_msaa_[0] + gpu_phase_draws_by_msaa_[1] + gpu_phase_draws_by_msaa_[2], 1));
+  REXGPU_INFO(
+      "ps5 gpu: {:.1f} s, {:.1f} frames/s. A frame's GPU time: draws {:.1f} ms ({:.0f} a frame), "
+      "between draws {:.1f} ms, EDRAM transfers {:.1f} ms ({:.0f} a frame), resolves {:.1f} ms "
+      "({:.0f} a frame), texture loads {:.1f} ms ({:.0f} a frame; of them resolved pictures read "
+      "back {:.1f} ms, {:.0f} a frame), uploads {:.1f} ms ({:.0f} a frame), frame out {:.1f} ms. "
+      "Draws by MSAA: 1x {:.0f}%, 2x {:.0f}%, 4x {:.0f}%",
+      seconds, frames / seconds, gpu_draw_ns_ / 1e6 / frames, double(gpu_draw_count_) / frames,
+      ms(GpuPhase::kDraw), ms(GpuPhase::kTransfer), per_frame(GpuPhase::kTransfer),
+      ms(GpuPhase::kResolve), per_frame(GpuPhase::kResolve),
+      ms(GpuPhase::kTextureLoad) + ms(GpuPhase::kResolvedLoad),
+      per_frame(GpuPhase::kTextureLoad) + per_frame(GpuPhase::kResolvedLoad),
+      ms(GpuPhase::kResolvedLoad), per_frame(GpuPhase::kResolvedLoad), ms(GpuPhase::kUpload),
+      per_frame(GpuPhase::kUpload),
+      ms(GpuPhase::kSwap), 100.0 * double(gpu_phase_draws_by_msaa_[0]) / msaa_draws,
+      100.0 * double(gpu_phase_draws_by_msaa_[1]) / msaa_draws,
+      100.0 * double(gpu_phase_draws_by_msaa_[2]) / msaa_draws);
+  // How long one draw took, in groups: many small ones or a few big ones.
+  REXGPU_INFO(
+      "ps5 gpu draws by time, a frame: under 10 us {:.0f} ({:.1f} ms), 10-50 us {:.0f} ({:.1f} ms), "
+      "50-200 us {:.0f} ({:.1f} ms), 0.2-1 ms {:.0f} ({:.1f} ms), over 1 ms {:.0f} ({:.1f} ms)",
+      double(gpu_draw_bucket_count_[0]) / frames, gpu_draw_bucket_ns_[0] / 1e6 / frames,
+      double(gpu_draw_bucket_count_[1]) / frames, gpu_draw_bucket_ns_[1] / 1e6 / frames,
+      double(gpu_draw_bucket_count_[2]) / frames, gpu_draw_bucket_ns_[2] / 1e6 / frames,
+      double(gpu_draw_bucket_count_[3]) / frames, gpu_draw_bucket_ns_[3] / 1e6 / frames,
+      double(gpu_draw_bucket_count_[4]) / frames, gpu_draw_bucket_ns_[4] / 1e6 / frames);
+  // The kinds of draw that took the most.
+  std::vector<uint32_t> order;
+  for (uint32_t id = 0; id < uint32_t(gpu_draw_kinds_.size()); ++id) {
+    if (gpu_draw_kind_count_[id]) {
+      order.push_back(id);
+    }
+  }
+  const size_t top = std::min<size_t>(order.size(), 12);
+  std::partial_sort(order.begin(), order.begin() + std::ptrdiff_t(top), order.end(),
+                    [this](uint32_t a, uint32_t b) {
+                      return gpu_draw_kind_ns_[a] > gpu_draw_kind_ns_[b];
+                    });
+  for (size_t i = 0; i < top; ++i) {
+    const uint32_t id = order[i];
+    const GpuDrawKind& kind = gpu_draw_kinds_[id];
+    const double count = double(gpu_draw_kind_count_[id]);
+    REXGPU_INFO(
+        "ps5 gpu top {}: {:.2f} ms a frame, {:.1f} draws a frame of {:.1f} us; vs {:016X} ps "
+        "{:016X}, MSAA {}x, RT0 {}, pitch {}, color mask {:04X}",
+        i + 1, gpu_draw_kind_ns_[id] / 1e6 / frames, count / frames,
+        gpu_draw_kind_ns_[id] / 1e3 / count, kind.vertex_shader_hash, kind.pixel_shader_hash,
+        1u << kind.msaa_samples,
+        xenos::GetColorRenderTargetFormatName(xenos::ColorRenderTargetFormat(kind.color_format)),
+        kind.surface_pitch, kind.color_mask);
+  }
+  // The EDRAM transfers by what they copy from and to, the most tiles first.
+  {
+    std::vector<std::pair<uint64_t, GpuTransferStats>> transfers(gpu_transfer_stats_.begin(),
+                                                                 gpu_transfer_stats_.end());
+    uint64_t total_tiles = 0;
+    for (const auto& transfer : transfers) {
+      total_tiles += transfer.second.tiles;
+    }
+    const size_t transfer_top = std::min<size_t>(transfers.size(), 10);
+    std::partial_sort(transfers.begin(), transfers.begin() + std::ptrdiff_t(transfer_top),
+                      transfers.end(), [](const auto& a, const auto& b) {
+                        return a.second.tiles > b.second.tiles;
+                      });
+    for (size_t i = 0; i < transfer_top; ++i) {
+      const GpuTransferStats& stats = transfers[i].second;
+      REXGPU_INFO(
+          "ps5 gpu transfer {}: {:.1f} a frame ({:.0f}% of the tiles copied{}), from {} to {}", i + 1,
+          double(stats.count) / frames,
+          total_tiles ? 100.0 * double(stats.tiles) / double(total_tiles) : 0.0,
+          stats.skipped ? fmt::format(", {} skipped", stats.skipped) : std::string(),
+          VulkanRenderTargetCache::DescribeKeyForLog(uint32_t(transfers[i].first >> 32)),
