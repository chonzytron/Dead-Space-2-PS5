diff --git a/include/rex/ps5_compat.h b/include/rex/ps5_compat.h
new file mode 100644
index 00000000..85c3c3ca
--- /dev/null
+++ b/include/rex/ps5_compat.h
@@ -0,0 +1,33 @@
+/**
+ * @file        rex/ps5_compat.h
+ * @brief       [ps5 port] Linux names the POSIX code uses, mapped to the PS5's
+ *              FreeBSD equivalents. Force-included on PS5 builds
+ *              (-include rex/ps5_compat.h); a no-op everywhere else.
+ *
+ * Macros only, no includes: it is force-included ahead of the precompiled
+ * headers, and declaring anything here (even via <stdio.h>) would declare
+ * clang's __va_list_tag twice and break va_list in PCH'd files.
+ */
+#pragma once
+
+#if defined(__PROSPERO__)
+
+// FreeBSD's off_t is always 64-bit: the *64 large-file names are the plain ones.
+#define fseeko64 fseeko
+#define ftello64 ftello
+#define ftruncate64 ftruncate
+#define lseek64 lseek
+#define mmap64 mmap
+#define pread64 pread
+#define pwrite64 pwrite
+#define fopen64 fopen
+#define open64 open
+#define fstat64 fstat
+#define stat64 stat
+#define lstat64 lstat
+#define off64_t off_t
+
+// Linux-only clock; the monotonic clock is the closest PS5 equivalent.
+#define CLOCK_MONOTONIC_RAW CLOCK_MONOTONIC
+
+#endif  // __PROSPERO__
diff --git a/include/rex/ps5_diag.h b/include/rex/ps5_diag.h
new file mode 100644
index 00000000..0ba6cab1
--- /dev/null
+++ b/include/rex/ps5_diag.h
@@ -0,0 +1,88 @@
+#pragma once
+/**
+ * @file        rex/ps5_diag.h
+ * @brief       [ps5 port] What a PS5 has instead of a debugger: progress
+ *              counters, where every thread is when the game stops drawing,
+ *              and a crash line at the end of the log.
+ *
+ * After the GTA IV PS5 port's rex/ps5_diag.h (elripalda), without its
+ * game-specific parts. Declared on every platform so shared code can call the
+ * counters; only the PS5 build has the implementation (src/core/ps5_diag.cpp).
+ */
+#include <atomic>
+#include <cstdint>
+
+#include <rex/platform.h>
+
+namespace rex::ps5diag {
+
+enum Counter : int {
+  kAccessViolations,  // faults reaching the MMIO handler
+  kMmioAccesses,      // of those, GPU register reads / writes emulated
+  kWatchFaults,       // of those, write watches / other handlers
+  kUnhandledFaults,   // of those, not handled (a real crash)
+  kVblanks,           // GPU vblanks
+  kInterrupts,        // guest GPU interrupt callbacks run
+  kWritePointer,      // ring buffer write pointer updates by the game
+  kPrimaryBuffers,    // ring buffer batches executed
+  kSwaps,             // frames the game presented
+  kGpuBusyUs,         // microseconds the GPU spent on the game's submissions
+  kGpuWaitUs,         // microseconds the command processor waited for the GPU
+  kCount
+};
+
+#if REX_PS5_PROGRAM
+extern std::atomic<uint64_t> counters[kCount];
+inline void Add(Counter c) { counters[c].fetch_add(1, std::memory_order_relaxed); }
+inline uint64_t Get(Counter c) { return counters[c].load(std::memory_order_relaxed); }
+inline void AddN(Counter c, uint64_t n) { counters[c].fetch_add(n, std::memory_order_relaxed); }
+
+// The reserved guest address space (all views live inside it).
+extern uintptr_t guest_arena_lo, guest_arena_hi;
+
+// Milliseconds on the TSC (a steady_clock read is a system call on the PS5).
+uint64_t NowMs();
+
+// Host stack samples: every rex thread registers itself; SampleAllThreads()
+// signals each one (SIGPROF), records its rip and the return-address-looking
+// words on its stack, and logs them relative to Anchor() so they can be
+// symbolized against the linked ELF offline (ps5/tools/ps5_symbolize.py).
+void RegisterThread(const char* what);
+// Before the calling thread exits: out of the samples.
+void UnregisterThread();
+void SampleAllThreads();
+
+// Where the time goes: every 10 ms each registered thread is asked (SIGPROF)
+// where it is, and every `report_seconds` the log gets, for each thread that
+// used the processor, how much of one core it used and the places it was
+// found at most ("ps5 prof:" lines, addresses as in the stack lines;
+// ps5/tools/ps5_symbolize.py names them). Costs a few percent while it runs.
+void StartProfiler(int report_seconds);
+// Whether StartProfiler was called (others then measure more, too).
+bool ProfilerRunning();
+
+// A host fault no handler took (a crash in some thread): the first one is
+// written to the end of the log file with the thread's return addresses
+// (without the heap); the thread then re-faults, and that calls crash_hook.
+void UnhandledHostFault(uintptr_t rip, uintptr_t address, uintptr_t rsp);
+// Called (once) when a thread keeps faulting: tells the player and ends the
+// game rather than leave it hanging. Set by main. It runs in the fault
+// handler: no heap (no logging) before it flushes the log.
+extern void (*crash_hook)(const char* what);
+// When the first unhandled fault was reported (NowMs() | 1; 0: none): a
+// watchdog ends the game if the crash hook doesn't.
+extern std::atomic<uint64_t> crashed_at_ms;
+// The log file, for the crash report (written without the logger).
+void SetLogPath(const char* path);
+// The game asked to quit (to the dashboard): the app's answer. Set: it
+// doesn't return when it succeeds.
+extern void (*title_exit_hook)();
+// An address inside the program: logged addresses are relative to it.
+uintptr_t Anchor();
+#else
+inline void Add(Counter) {}
+inline void AddN(Counter, uint64_t) {}
+inline bool ProfilerRunning() { return false; }
+#endif
+
+}  // namespace rex::ps5diag
