+void VulkanCommandProcessor::ReadGpuTimestamps(uint64_t first_submission,
+                                               uint64_t last_submission) {
+  if (gpu_timestamp_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  VkDevice device = GetVulkanDevice()->device();
+  uint64_t busy_ticks = 0;
+  for (uint64_t submission = first_submission; submission <= last_submission; ++submission) {
+    const uint32_t slot = uint32_t(submission % kGpuTimestampSlots);
+    if (gpu_timestamp_slot_submission_[slot] != submission) {
+      continue;
+    }
+    gpu_timestamp_slot_submission_[slot] = 0;
+    uint64_t ticks[2];
+    // (its fence is signalled: the results are there, no waiting)
+    if (GetVulkanDevice()->functions().vkGetQueryPoolResults(
+            device, gpu_timestamp_pool_, slot * 2, 2, sizeof(ticks), ticks, sizeof(uint64_t),
+            VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    uint64_t start = ticks[0] & gpu_timestamp_mask_;
+    const uint64_t end = ticks[1] & gpu_timestamp_mask_;
+    if (end < start || end - start > gpu_timestamp_one_second_) {
+      continue;  // (the counter wrapped, or nonsense)
+    }
+    // A submission that began before the last one ended: counted from there.
+    if (gpu_timestamp_last_end_ > start &&
+        gpu_timestamp_last_end_ - start < gpu_timestamp_one_second_) {
+      start = std::min(gpu_timestamp_last_end_, end);
+    }
+    busy_ticks += end - start;
+    if (end > gpu_timestamp_last_end_ ||
+        gpu_timestamp_last_end_ - end >= gpu_timestamp_one_second_) {
+      gpu_timestamp_last_end_ = end;
+    }
+  }
+  if (!busy_ticks) {
+    return;
+  }
+  gpu_busy_ns_unreported_ += double(busy_ticks) * gpu_timestamp_ns_per_tick_;
+  const uint64_t busy_us = uint64_t(gpu_busy_ns_unreported_ / 1000.0);
+  if (busy_us) {
+    rex::ps5diag::AddN(rex::ps5diag::kGpuBusyUs, busy_us);
+    gpu_busy_ns_unreported_ -= double(busy_us) * 1000.0;
+  }
+}
