+    if (!volatile_filtered_ranges_.empty()) {
+      std::pair<uint32_t, uint32_t>& last = volatile_filtered_ranges_.back();
+      if (last.first + last.second == page) {
+        ++last.second;
+        return;
+      }
+    }
+    volatile_filtered_ranges_.emplace_back(page, 1);
+  };
+  for (const std::pair<uint32_t, uint32_t>& range : upload_ranges_) {
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      if (!IsPageVolatile(page)) {
+        // Uploaded and protected the usual way.
+        keep(page);
+        continue;
+      }
+      VolatilePage& info = volatile_pages_[page];
+      // (read before the page: the hash is kept under these numbers, and if
+      // the page stops being volatile meanwhile it is never used)
+      const uint32_t epoch = info.epoch.load(std::memory_order_relaxed);
+      const uint32_t generation = volatile_generation_.load(std::memory_order_relaxed);
+      // The hash is taken before the upload reads the page: if the game writes
+      // in between, it is of the older of the two and the next look finds the
+      // difference.
+      const uint64_t hash = HashGuestPage(page);
